# Copy to .env.local for development. Set the same values in Vercel for production.
# Never commit real values. Only NEXT_PUBLIC_* variables reach the browser.

# Supabase: Project Settings > API. The service role / secret key bypasses RLS: server only.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# SendGrid: needs an API key with Mail Send permission and vx44ai.com domain authentication.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=leads@vx44ai.com
# Comma-separated list of the admins who receive new-lead emails.
ADMIN_EMAILS=

# Cloudflare Turnstile. The values below are Cloudflare's always-pass TEST keys, for local
# development only. Use real keys for vx44ai.com in production.
# The site key is built into the page, so redeploy after changing it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Random secret of at least 16 characters, used to hash IPs before rate limiting.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SALT=
